PORT=3000
WEB_APP_URL=http://localhost:3001

# Public project URL used by the backend to validate Supabase JWTs.
SUPABASE_URL=https://your-project.supabase.co

# Copy the database connection strings from Supabase > Connect.
# Use the pooled connection string for DATABASE_URL when appropriate.
DATABASE_URL=postgresql://postgres:replace-me@your-database-host:5432/postgres?schema=public
# Use the direct PostgreSQL connection string for Prisma CLI operations.
DIRECT_URL=postgresql://postgres:replace-me@db.your-project.supabase.co:5432/postgres?schema=public

# Required only for automatic personal/tenant provisioning.
ONBOARDING_TRIAL_PLAN_ID=
ONBOARDING_TRIAL_DAYS=14

# Stripe keys must remain on the backend; use test keys outside production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
