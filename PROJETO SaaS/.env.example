SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Necessaria para gerar o client Prisma, rodar migrations e executar testes de banco.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?schema=public

# Opcional. Exclusivo para testes de integração: o alvo é limpo antes de cada cenário.
# Use um banco/schema isolado cujo nome termine em _test; nunca use produção.
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?schema=saas_test
