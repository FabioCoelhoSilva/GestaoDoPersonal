{
  "name": "projeto-saas",
  "version": "1.0.0",
  "description": "SaaS para Personal Trainer - Fase 7",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "prisma:generate": "./node_modules/.bin/prisma generate",
    "prisma:billing-migrate": "./node_modules/.bin/prisma db execute --schema prisma/schema.prisma --file prisma/migrations/manual_billing_webhooks/migration.sql",
    "prisma:billing-plans-migrate": "./node_modules/.bin/prisma db execute --schema prisma/schema.prisma --file prisma/migrations/manual_billing_plans/migration.sql",
    "prisma:appointments-migrate": "./node_modules/.bin/prisma db execute --schema prisma/schema.prisma --file prisma/migrations/manual_appointments/migration.sql",
    "prisma:workout-days-migrate": "./node_modules/.bin/prisma db execute --schema prisma/schema.prisma --file prisma/migrations/manual_workout_training_days/migration.sql",
    "prisma:migrate": "./node_modules/.bin/prisma migrate dev --name init_fase7",
    "prisma:execute": "./node_modules/.bin/prisma db execute --file prisma/migrations/manual_integridade/migration.sql",
    "db:seed": "tsx prisma/seed.ts",
    "test:isolation": "node scripts/run-isolation-tests.cjs tests/isolation.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@prisma/client": "^5.x.x",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^5.x.x",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
