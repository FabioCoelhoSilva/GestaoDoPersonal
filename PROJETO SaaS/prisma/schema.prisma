// schema.prisma — consolidado (Fases 1 a 7)
// Regras:
// - personalId é o tenant. Toda tabela de tenant tem personalId NOT NULL.
// - Chaves compostas (id, personalId) + FKs compostas em migration SQL impedem vínculo entre tenants.
// - Sem cascade físico em relações financeiras (Restrict). Anonimização LGPD em vez de deleção.
// - Campos sensíveis (cpf, extractedData) armazenados como payload cifrado (AES-256 na aplicação).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  PERSONAL
  STUDENT
}

enum AuthProvider {
  GOV_BR
  OAUTH
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  CANCELLED // cancelamento antecipado
  EXPIRED   // fim do ciclo sem cancelamento (não-renovação quando não há novo contrato)
}

enum CycleDuration {
  MONTHS_3
  MONTHS_6
  MONTHS_12
}

enum ParcelStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum ExamStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
}

// ---------- Autenticação, LGPD e auditoria ----------

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  role         Role
  provider     AuthProvider
  providerSub  String?      @unique // identificador do Gov.br / OAuth
  passwordHash String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  personal     Personal?
  student      Student?
  consents     ConsentGrant[]
  accessLogs   AccessLog[]

  @@map("users")
}

// Append-only: UPDATE e DELETE bloqueados por trigger (ver migration manual)
model AccessLog {
  id          String   @id @default(uuid())
  userId      String?
  personalId  String?  // tenant de contexto, quando houver
  action      String   // ex.: READ, WRITE, EXPORT
  resource    String   // ex.: exam, student, dashboard.executive
  resourceId  String?
  purpose     String?  // finalidade declarada (PURPOSE_SCOPES)
  ip          String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([personalId, createdAt])
  @@index([userId, createdAt])
  @@map("access_logs")
}

// Consentimento versionado por finalidade
model ConsentGrant {
  id            String   @id @default(uuid())
  userId        String
  scopes        String[] // PURPOSE_SCOPES aceitos
  policyVersion String
  grantedAt     DateTime @default(now())
  revokedAt     DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("consent_grants")
}

// ---------- Tenant: personal ----------

model Personal {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  students       Student[]
  leads          Lead[]
  contracts      Contract[]
  paymentParcels PaymentParcel[]
  extraPayments  ExtraPayment[]
  workouts       Workout[]
  exams          Exam[]

  @@map("personals")
}

model Student {
  id          String    @id @default(uuid())
  personalId  String
  userId      String?   @unique
  name        String
  email       String
  cpfEncrypted String?  // payload AES-256 (versão:iv:tag:cifra), base64
  cpfHash     String?   // HMAC do CPF para deduplicação sem expor o valor
  active      Boolean   @default(true)
  anonymizedAt DateTime? // LGPD: cadastro anonimizado, histórico financeiro retido
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  personal    Personal  @relation(fields: [personalId], references: [id], onDelete: Restrict)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts   Contract[]
  workouts    Workout[]
  exams       Exam[]
  extraPayments ExtraPayment[]
  convertedLeads Lead[] @relation("LeadConversion")

  @@unique([id, personalId])
  @@unique([personalId, cpfHash])
  @@index([personalId, active])
  @@map("students")
}

model Lead {
  id                 String     @id @default(uuid())
  personalId         String
  name               String
  email              String
  phone              String?
  status             LeadStatus @default(NEW)
  convertedStudentId String?
  convertedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  personal           Personal   @relation(fields: [personalId], references: [id], onDelete: Restrict)
  convertedStudent   Student?   @relation("LeadConversion", fields: [convertedStudentId], references: [id], onDelete: Restrict)

  @@unique([id, personalId])
  @@index([personalId, status])
  @@map("leads")
}

model Contract {
  id            String         @id @default(uuid())
  personalId    String
  studentId     String
  cycle         CycleDuration
  status        ContractStatus @default(DRAFT)
  totalAmount   Decimal
  monthlyAmount Decimal
  startDate     DateTime
  endDate       DateTime
  signedAt      DateTime?
  cancelledAt   DateTime?
  documentS3Key String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  personal      Personal       @relation(fields: [personalId], references: [id], onDelete: Restrict)
  student       Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  parcels       PaymentParcel[]

  @@unique([id, personalId])
  @@index([personalId, status, endDate])
  @@index([studentId])
  @@map("contracts")
}

model PaymentParcel {
  id           String       @id @default(uuid())
  personalId   String
  contractId   String
  dueDate      DateTime
  confirmedAt  DateTime?
  amount       Decimal
  status       ParcelStatus @default(PENDING)
  pixCopyPaste String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  personal     Personal     @relation(fields: [personalId], references: [id], onDelete: Restrict)
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([id, personalId])
  @@index([personalId, status, dueDate])
  @@index([contractId])
  @@map("payment_parcels")
}

// Receita avulsa: fora do MRR
model ExtraPayment {
  id           String       @id @default(uuid())
  personalId   String
  studentId    String?
  description  String?
  amount       Decimal
  dueDate      DateTime?
  status       ParcelStatus @default(PENDING)
  pixCopyPaste String?
  confirmedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  personal     Personal     @relation(fields: [personalId], references: [id], onDelete: Restrict)
  student      Student?     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([id, personalId])
  @@index([personalId, status, confirmedAt])
  @@map("extra_payments")
}

model Workout {
  id          String   @id @default(uuid())
  personalId  String
  studentId   String
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  personal    Personal @relation(fields: [personalId], references: [id], onDelete: Restrict)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([id, personalId])
  @@index([personalId, studentId, updatedAt])
  @@map("workouts")
}

model Exam {
  id                      String     @id @default(uuid())
  personalId              String
  studentId               String
  fileS3Key               String
  status                  ExamStatus @default(PENDING_REVIEW)
  extractedDataEncrypted  String?    // payload AES-256 (versão:iv:tag:cifra), base64
  confirmedAt             DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  personal    Personal   @relation(fields: [personalId], references: [id], onDelete: Restrict)
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([id, personalId])
  @@index([personalId, status])
  @@map("exams")
}
