// schema.prisma — consolidado (Fases 1 a 7)
// Regras:
// - personalId é o tenant. Toda tabela de tenant tem personalId NOT NULL.
// - Chaves compostas (id, personalId) + FKs compostas em migration SQL impedem vínculo entre tenants.
// - Sem cascade físico em relações financeiras (Restrict). Anonimização LGPD em vez de deleção.
// - Campos sensíveis (cpf, extractedData) armazenados como payload cifrado (AES-256 na aplicação).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  PERSONAL
  STUDENT
}

enum AuthProvider {
  GOV_BR
  OAUTH
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  CANCELLED // cancelamento antecipado
  EXPIRED // fim do ciclo sem cancelamento (não-renovação quando não há novo contrato)
}

enum CycleDuration {
  MONTHS_3
  MONTHS_6
  MONTHS_12
}

enum ParcelStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

enum ExamStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
}

enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

enum WorkoutExecutionStatus {
  IN_PROGRESS
  COMPLETED
}

enum WorkoutDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ---------- Autenticação, LGPD e auditoria ----------

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  role         Role
  provider     AuthProvider
  providerSub  String?      @unique // identificador do Gov.br / OAuth
  passwordHash String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  personal   Personal?
  student    Student?
  consents   ConsentGrant[]
  accessLogs AccessLog[]

  @@map("users")
}

// Append-only: UPDATE e DELETE bloqueados por trigger (ver migration manual)
model AccessLog {
  id         String   @id @default(uuid())
  userId     String?
  personalId String? // tenant de contexto, quando houver
  action     String // ex.: READ, WRITE, EXPORT
  resource   String // ex.: exam, student, dashboard.executive
  resourceId String?
  purpose    String? // finalidade declarada (PURPOSE_SCOPES)
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([personalId, createdAt])
  @@index([userId, createdAt])
  @@map("access_logs")
}

// Consentimento versionado por finalidade
model ConsentGrant {
  id            String    @id @default(uuid())
  userId        String
  scopes        String[] // PURPOSE_SCOPES aceitos
  policyVersion String
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("consent_grants")
}

// ---------- Tenant: personal ----------

model Personal {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  students            Student[]
  leads               Lead[]
  contracts           Contract[]
  paymentParcels      PaymentParcel[]
  extraPayments       ExtraPayment[]
  workouts            Workout[]
  exams               Exam[]
  billingSubscription BillingSubscription?
  stripeWebhookEvents StripeWebhookEvent[]
  workoutExecutions   WorkoutExecution[]
  workoutSetLogs      WorkoutSetLog[]
  appointments        Appointment[]

  @@map("personals")
}

model Student {
  id           String    @id @default(uuid())
  personalId   String
  userId       String?   @unique
  name         String
  email        String
  cpfEncrypted String? // payload AES-256 (versão:iv:tag:cifra), base64
  cpfHash      String? // HMAC do CPF para deduplicação sem expor o valor
  active       Boolean   @default(true)
  anonymizedAt DateTime? // LGPD: cadastro anonimizado, histórico financeiro retido
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  personal          Personal           @relation(fields: [personalId], references: [id], onDelete: Restrict)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  contracts         Contract[]
  workouts          Workout[]
  workoutExecutions WorkoutExecution[]
  exams             Exam[]
  extraPayments     ExtraPayment[]
  convertedLeads    Lead[]             @relation("LeadConversion")
  appointments      Appointment[]

  @@unique([id, personalId])
  @@unique([personalId, cpfHash])
  @@index([personalId, active])
  @@map("students")
}

model Lead {
  id                 String     @id @default(uuid())
  personalId         String
  name               String
  email              String
  phone              String?
  status             LeadStatus @default(NEW)
  convertedStudentId String?
  convertedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  personal         Personal @relation(fields: [personalId], references: [id], onDelete: Restrict)
  convertedStudent Student? @relation("LeadConversion", fields: [convertedStudentId], references: [id], onDelete: Restrict)

  @@unique([id, personalId])
  @@index([personalId, status])
  @@map("leads")
}

model Contract {
  id            String         @id @default(uuid())
  personalId    String
  studentId     String
  cycle         CycleDuration
  status        ContractStatus @default(DRAFT)
  totalAmount   Decimal
  monthlyAmount Decimal
  startDate     DateTime
  endDate       DateTime
  signedAt      DateTime?
  cancelledAt   DateTime?
  documentS3Key String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  personal Personal        @relation(fields: [personalId], references: [id], onDelete: Restrict)
  student  Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  parcels  PaymentParcel[]

  @@unique([id, personalId])
  @@index([personalId, status, endDate])
  @@index([studentId])
  @@map("contracts")
}

model PaymentParcel {
  id           String       @id @default(uuid())
  personalId   String
  contractId   String
  dueDate      DateTime
  confirmedAt  DateTime?
  amount       Decimal
  status       ParcelStatus @default(PENDING)
  pixCopyPaste String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  personal Personal @relation(fields: [personalId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([id, personalId])
  @@index([personalId, status, dueDate])
  @@index([contractId])
  @@map("payment_parcels")
}

// Receita avulsa: fora do MRR
model ExtraPayment {
  id           String       @id @default(uuid())
  personalId   String
  studentId    String?
  description  String?
  amount       Decimal
  dueDate      DateTime?
  status       ParcelStatus @default(PENDING)
  pixCopyPaste String?
  confirmedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  personal Personal @relation(fields: [personalId], references: [id], onDelete: Restrict)
  student  Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([id, personalId])
  @@index([personalId, status, confirmedAt])
  @@map("extra_payments")
}

model Appointment {
  id         String            @id @default(uuid())
  personalId String
  studentId  String
  workoutId  String?
  title      String
  startsAt   DateTime
  endsAt     DateTime
  notes      String?
  status     AppointmentStatus @default(SCHEDULED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  personal Personal @relation(fields: [personalId], references: [id], onDelete: Restrict)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  workout  Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@unique([id, personalId])
  @@index([personalId, startsAt, endsAt, status])
  @@index([studentId, startsAt])
  @@index([workoutId])
  @@map("appointments")
}

model Workout {
  id           String       @id @default(uuid())
  personalId   String
  studentId    String
  title        String
  description  String?
  trainingDays WorkoutDay[] @default([])
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  personal     Personal           @relation(fields: [personalId], references: [id], onDelete: Restrict)
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  exercises    WorkoutExercise[]
  executions   WorkoutExecution[]
  setLogs      WorkoutSetLog[]
  appointments Appointment[]

  @@unique([id, personalId])
  @@index([personalId, studentId, updatedAt])
  @@map("workouts")
}

model WorkoutExercise {
  id          String   @id @default(uuid())
  personalId  String
  workoutId   String
  name        String
  gifUrl      String?  @db.VarChar(2048)
  sets        Int
  reps        String
  restSeconds Int?
  order       Int
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workout Workout         @relation(fields: [workoutId, personalId], references: [id, personalId], onDelete: Cascade)
  setLogs WorkoutSetLog[]

  @@unique([workoutId, personalId, order])
  @@index([personalId, workoutId])
  @@map("workout_exercises")
}

model WorkoutExecution {
  id          String                 @id @default(uuid())
  personalId  String
  studentId   String
  workoutId   String
  status      WorkoutExecutionStatus @default(IN_PROGRESS)
  startedAt   DateTime               @default(now())
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  personal Personal        @relation(fields: [personalId], references: [id], onDelete: Restrict, map: "workout_executions_personal_fk")
  student  Student         @relation(fields: [studentId, personalId], references: [id, personalId], onDelete: Restrict, map: "workout_executions_student_tenant_fk")
  workout  Workout         @relation(fields: [workoutId, personalId], references: [id, personalId], onDelete: Restrict, map: "workout_executions_workout_tenant_fk")
  setLogs  WorkoutSetLog[]

  @@index([personalId, studentId, startedAt])
  @@index([personalId, workoutId, startedAt])
  @@map("workout_executions")
}

model WorkoutSetLog {
  id                String   @id @default(uuid())
  personalId        String
  workoutId         String
  executionId       String
  workoutExerciseId String
  setNumber         Int
  repsCompleted     Int
  loadKg            Decimal? @db.Decimal(8, 2)
  createdAt         DateTime @default(now())

  personal        Personal         @relation(fields: [personalId], references: [id], onDelete: Restrict, map: "workout_set_logs_personal_fk")
  execution       WorkoutExecution @relation(fields: [executionId], references: [id], onDelete: Cascade, map: "workout_set_logs_execution_fk")
  workout         Workout          @relation(fields: [workoutId, personalId], references: [id, personalId], onDelete: Restrict, map: "workout_set_logs_workout_tenant_fk")
  workoutExercise WorkoutExercise  @relation(fields: [workoutExerciseId], references: [id], onDelete: Restrict, map: "workout_set_logs_exercise_fk")

  @@unique([executionId, workoutExerciseId, setNumber])
  @@index([personalId, executionId])
  @@map("workout_set_logs")
}

model Exam {
  id                     String     @id @default(uuid())
  personalId             String
  studentId              String
  fileS3Key              String
  status                 ExamStatus @default(PENDING_REVIEW)
  extractedDataEncrypted String? // payload AES-256 (versão:iv:tag:cifra), base64
  confirmedAt            DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  personal Personal @relation(fields: [personalId], references: [id], onDelete: Restrict)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([id, personalId])
  @@index([personalId, status])
  @@map("exams")
}

model BillingSubscription {
  id                   String        @id @default(uuid())
  personalId           String        @unique
  planId               String?
  stripeSubscriptionId String        @unique
  stripeCustomerId     String?
  stripePriceId        String
  status               BillingStatus
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  lastEventCreated     Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  personal Personal @relation(fields: [personalId], references: [id], onDelete: Restrict)
  plan     Plan?    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@map("billing_subscriptions")
}

model Plan {
  id            String   @id @default(uuid())
  name          String   @unique
  stripePriceId String   @unique
  maxStudents   Int?
  maxWorkouts   Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions BillingSubscription[]

  @@map("plans")
}

model StripeWebhookEvent {
  eventId        String   @id
  type           String
  personalId     String
  subscriptionId String
  receivedAt     DateTime @default(now())

  personal Personal @relation(fields: [personalId], references: [id], onDelete: Restrict)

  @@index([personalId, receivedAt])
  @@map("stripe_webhook_events")
}
